    {
      "id": "vxfki_uVy6RSQJZd9FFPE",
      "type": "text",
      "x": -269.5649602090094,
      "y": 673.0486980639904,
      "width": 589.06640625,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1345134911,
      "version": 410,
      "versionNonce": 726123807,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786416278088,
      "link": null,
      "locked": false,
      "text": "Customers may have a discount\napplied to their Azure bill, as\ncompensation for an under-performing\nAzure product or service based on the SLA",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Customers may have a discount\napplied to their Azure bill, as\ncompensation for an under-performing\nAzure product or service based on the SLA",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "x1YJGFlR4gUJHcMpUFVce",
      "type": "text",
      "x": 698.4472206643165,
      "y": 668.3723587782761,
      "width": 425.40576171875,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8V",
      "roundness": null,
      "seed": 1224394833,
      "version": 611,
      "versionNonce": 675982399,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786416388982,
      "link": null,
      "locked": false,
      "text": "This tool helps estimate\nthe cost saving you can realize\nby migrating your workloads\nto Azure.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This tool helps estimate\nthe cost saving you can realize\nby migrating your workloads\nto Azure.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UHYTgGMsv0AeEriTzgXSf",
      "type": "text",
      "x": 1576.5239147289867,
      "y": 996.362793212955,
      "width": 545.4981689453125,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8d",
      "roundness": null,
      "seed": 1761721866,
      "version": 957,
      "versionNonce": 447647958,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786499614374,
      "link": null,
      "locked": false,
      "text": "Perform cost-analysis, visualize the\nspending of your Azure Cloud resources.\n\n--> Create budgets, set a budget\nthreshold and be alerted when\napproaching or exceeded.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Perform cost-analysis, visualize the\nspending of your Azure Cloud resources.\n\n--> Create budgets, set a budget\nthreshold and be alerted when\napproaching or exceeded.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vlPp5sK5YEXi_diwdGj1G",
      "type": "text",
      "x": 478.4110268166603,
      "y": 991.8711609633347,
      "width": 380.21356201171875,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8l",
      "roundness": null,
      "seed": 1530667519,
      "version": 816,
      "versionNonce": 136060849,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786416520462,
      "link": null,
      "locked": false,
      "text": "This marketplace are apps\nand services made available\nby third-party publishers to\nquickly get started.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This marketplace are apps\nand services made available\nby third-party publishers to\nquickly get started.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Vh4IJW-uH62CWiQjJ44XN",
      "type": "text",
      "x": -279.34764291717204,
      "y": 1038.451854009423,
      "width": 535.3621826171875,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8t",
      "roundness": null,
      "seed": 175097535,
      "version": 1031,
      "versionNonce": 1478689823,
      "isDeleted": false,
      "boundElements": [
