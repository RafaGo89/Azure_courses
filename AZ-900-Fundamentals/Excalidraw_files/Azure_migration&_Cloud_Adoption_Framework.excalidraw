      "seed": 950061662,
      "version": 617,
      "versionNonce": 367008450,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785118232354,
      "link": null,
      "locked": false,
      "text": "This offers a streamlined service for migration,\nmodernization and optimization on Azure.\n\n--> It simplifies the pre-migration process like\ndiscovering, assessing and appropriately sizing\non-premises resources for infrastructure,\ndata and apps.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
