    {
      "id": "vxfki_uVy6RSQJZd9FFPE",
      "type": "text",
      "x": -269.5649602090094,
      "y": 673.0486980639904,
      "width": 589.06640625,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1345134911,
      "version": 411,
      "versionNonce": 237487114,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786499730009,
      "link": null,
      "locked": false,
      "text": "Customers may have a discount\napplied to their Azure bill, as\ncompensation for an under-performing\nAzure product or service based on the SLA",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Customers may have a discount\napplied to their Azure bill, as\ncompensation for an under-performing\nAzure product or service based on the SLA",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "x1YJGFlR4gUJHcMpUFVce",
      "type": "text",
      "x": 698.4472206643165,
      "y": 668.3723587782761,
      "width": 425.40576171875,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8V",
      "roundness": null,
      "seed": 1224394833,
      "version": 612,
      "versionNonce": 472766870,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786499730009,
      "link": null,
      "locked": false,
      "text": "This tool helps estimate\nthe cost saving you can realize\nby migrating your workloads\nto Azure.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This tool helps estimate\nthe cost saving you can realize\nby migrating your workloads\nto Azure.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UHYTgGMsv0AeEriTzgXSf",
      "type": "text",
      "x": 1576.5239147289867,
      "y": 996.362793212955,
      "width": 545.4981689453125,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8d",
      "roundness": null,
      "seed": 1761721866,
      "version": 958,
      "versionNonce": 1768338122,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786499730009,
      "link": null,
      "locked": false,
      "text": "Perform cost-analysis, visualize the\nspending of your Azure Cloud resources.\n\n--> Create budgets, set a budget\nthreshold and be alerted when\napproaching or exceeded.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Perform cost-analysis, visualize the\nspending of your Azure Cloud resources.\n\n--> Create budgets, set a budget\nthreshold and be alerted when\napproaching or exceeded.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vlPp5sK5YEXi_diwdGj1G",
      "type": "text",
      "x": 478.4110268166603,
      "y": 991.8711609633347,
      "width": 380.21356201171875,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8l",
      "roundness": null,
      "seed": 1530667519,
      "version": 817,
      "versionNonce": 1269446358,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786499730009,
      "link": null,
      "locked": false,
      "text": "This marketplace are apps\nand services made available\nby third-party publishers to\nquickly get started.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This marketplace are apps\nand services made available\nby third-party publishers to\nquickly get started.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Vh4IJW-uH62CWiQjJ44XN",
      "type": "text",
      "x": -279.34764291717204,
      "y": 1038.451854009423,
      "width": 535.3621826171875,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8t",
      "roundness": null,
      "seed": 175097535,
      "version": 1032,
      "versionNonce": 1146734986,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "b3SI8uyTMmvaKOMDPhWH3",
          "type": "arrow"
        }
      ],
      "updated": 1786499730009,
      "link": null,
      "locked": false,
      "text": "Many customers have invested\nin Windows server licenses and\nwould like to repurpose this investment\non Azure.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Many customers have invested\nin Windows server licenses and\nwould like to repurpose this investment\non Azure.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dg5q4bwhTpmeZnYCB-l1o",
      "type": "text",
      "x": -241.74315920677714,
      "y": 1345.6109048449264,
      "width": 451.3337707519531,
      "height": 105,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8x",
      "roundness": null,
      "seed": 218935569,
      "version": 1241,
      "versionNonce": 505998358,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786499730009,
      "link": null,
      "locked": false,
      "text": "Azure Hybrid Use Benefit (HUB)\ngives customers the right to use\nthese licenses for VM's on Azure.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Azure Hybrid Use Benefit (HUB)\ngives customers the right to use\nthese licenses for VM's on Azure.",
      "autoResize": true,
      "lineHeight": 1.25
    },
