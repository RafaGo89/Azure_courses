      "boundElements": null,
      "updated": 1786500006212,
      "link": null,
      "locked": false,
      "text": "Azure Policy enforce organizational\nstandards and to assess compliance\nat-scale.\n\n-->Policies DO NOT RESTRICT ACCESS,\nthey only observe for compliance.",
      "fontSize": 40.545458984375,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Azure Policy enforce organizational\nstandards and to assess compliance\nat-scale.\n\n-->Policies DO NOT RESTRICT ACCESS,\nthey only observe for compliance.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nPOIPjn1Ku4IZjuq1ZukB",
      "type": "text",
      "x": 991.1271139114017,
      "y": 1537.687594824196,
      "width": 610.2774658203125,
      "height": 253.40911865234375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aPG",
      "roundness": null,
      "seed": 510531926,
      "version": 528,
      "versionNonce": 860017302,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786500146322,
      "link": null,
      "locked": false,
      "text": "Those enable quick creation of\ngoverned subscriptions.\n\n--> The service is designed to\nhelp with environment setup.",
      "fontSize": 40.545458984375,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Those enable quick creation of\ngoverned subscriptions.\n\n--> The service is designed to\nhelp with environment setup.",
